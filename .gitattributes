* text=auto eol=lf
# The development repository's own workflows never reach the public one.
.github/workflows/release-pr.yml export-ignore
.github/workflows/dev-pr.yml export-ignore
# SCIP indexes are binary protobuf.
*.scip binary
# The vendored SQLite amalgamation is stored and checked out byte for byte
# (tests/sqlite_pin.rs pins its SHA-256).
vendor/sqlite/** -text
